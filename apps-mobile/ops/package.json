{
  "name": "ops-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "运维 App（Taro 4 + React Native 双目标，S9-05）：登录/工作台/告警/工单离线草稿/巡检/设置",
  "scripts": {
    "dev:rn": "npm run build:rn -- --watch",
    "build:rn": "taro build --type rn",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:weapp": "taro build --type weapp",
    "build:rn-android": "cd android && ./gradlew assembleDebug",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src config"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@micro/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@tarojs/components": "^4.3.0",
    "@tarojs/components-rn": "^4.3.0",
    "@tarojs/plugin-framework-react": "^4.3.0",
    "@tarojs/plugin-platform-weapp": "^4.3.0",
    "@tarojs/react": "^4.3.0",
    "@tarojs/rn-runner": "^4.3.0",
    "@tarojs/rn-supporter": "^4.3.0",
    "@tarojs/router": "^4.3.0",
    "@tarojs/router-rn": "^4.3.0",
    "@tarojs/runtime": "^4.3.0",
    "@tarojs/runtime-rn": "^4.3.0",
    "@tarojs/taro": "^4.3.0",
    "@tarojs/taro-rn": "^4.3.0",
    "expo": "~52.0.0",
    "expo-av": "~15.0.1",
    "expo-barcode-scanner": "~13.0.1",
    "expo-camera": "~16.0.9",
    "expo-file-system": "~18.0.4",
    "expo-image-picker": "~16.0.2",
    "expo-location": "~18.0.2",
    "expo-media-library": "~17.0.2",
    "react": "18.3.1",
    "react-native": "^0.76.5",
    "react-native-gesture-handler": "^2.22.0",
    "react-native-reanimated": "^3.16.6",
    "react-native-safe-area-context": "^4.14.0",
    "react-native-screens": "^4.5.0",
    "react-native-svg": "^15.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "^18.3.18",
    "@types/webpack-env": "^1.18.8",
    "@tarojs/cli": "^4.3.0",
    "@tarojs/webpack5-runner": "^4.3.0",
    "babel-preset-taro": "^4.3.0",
    "oxlint": "^1.24.0",
    "typescript": "^5.9.3",
    "webpack": "^5.97.1"
  }
